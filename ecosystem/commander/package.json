{
  "name": "convertible-cranium-commander",
  "private": true,
  "version": "1.0.0-next",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node ./node_modules/vite/bin/vite.js build && node ./scripts/build-server.mjs",
    "start": "node dist/server.cjs",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "verify:architecture": "node scripts/verify-architecture.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
